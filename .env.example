# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Meta Model API (dev.meta.ai → API keys). Responses API at https://api.meta.ai/v1
MODEL_API_KEY=

# Baseten, Muse Spark Open at https://inference.baseten.co/v1. The model ID depends on the
# workspace: meta-models/muse-spark-open-1026 (default) or meta-models/muse-spark-open.
BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open

# Fireworks (app.fireworks.ai → API Keys) at https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=

# Modal CLI/SDK login doesn't use this file: `modal setup` stores a token in ~/.modal.toml.
# Calling a Modal Endpoint over HTTP needs a proxy token (`modal workspace proxy-tokens create`).
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Muse Glimmer 30B on our Modal Dedicated Endpoint (modal endpoint info glimmer -> URL); run_agent.py --glimmer
GLIMMER_URL=

# Hugging Face read token, for the open-weights SAM (facebook/sam3.1, facebook/sam3; accept
# the SAM License on both pages). Stored in Modal as: modal secret create huggingface HF_TOKEN=...
HF_TOKEN=

# Segmenter: api (Meta Model API sam-3.1, default) or open (SAM open weights on Modal, paid from Modal credits;
# deploy modal_apps/sam3_open.py first). run_agent.py --sam api|open overrides it.
SAM_BACKEND=api
