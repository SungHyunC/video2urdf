# Copy to .env (git-ignored) and fill in. Never commit real keys.

# meta  = Meta Model API (https://api.meta.ai/v1), Muse Spark
# local = open weights (Muse Glimmer via vLLM) behind `ssh -L 8000:localhost:8000 <a100-host>`
V2U_PROFILE=meta

# Meta Model API key: dev.meta.ai -> Dashboard -> API keys -> Create API key
MODEL_API_KEY=

# Optional overrides of the profile defaults
# V2U_BASE_URL=http://localhost:8000/v1
# V2U_MODEL=muse-glimmer
# V2U_API_KEY=
