<?xml version='1.0' encoding='utf-8'?>
<!-- Video2URDF model "laptop_lidar", measured from a video (https://github.com/SungHyunC/video2urdf).
     Mesh and texture paths are relative to this file (meshes/...): this file alone won't load;
     unzip model.zip (the viewer's "Download model + meshes") and load it from there.
     Units: metres, kilograms, radians. Fix the root link "base", its origin 0.0198 m above the floor.
     Collisions are the measured geometry; visuals may be the design, video texture or SAM 3D mesh.
     PyBullet: loadURDF(path, useFixedBase=True, flags=URDF_USE_INERTIA_FROM_FILE).
       PyBullet doesn't apply <dynamics friction>: set VELOCITY_CONTROL, targetVelocity=0,
       force=friction on each joint. MuJoCo 3.2.5+: simulate model.xml, which excludes contacts
       between parts joined by a joint (they overlap there); MuJoCo's URDF import can't.
     The <mujoco> element only keeps mesh paths for MuJoCo's URDF import; other parsers ignore it.
     ROS: mesh paths must become package://<your_package>/meshes/... for RViz and Gazebo. -->
<robot name="laptop_lidar">
  <mujoco>
    <compiler strippath="false" />
  </mujoco>
  <link name="base">
    <visual name="design_base_0">
      <origin xyz="0.00000 0.00000 0.00000" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <mesh filename="meshes/design_base_0.obj" />
      </geometry>
      <material name="design_base_0_color">
        <color rgba="0.78000 0.80000 0.82000 1" />
      </material>
    </visual>
    <visual name="design_base_1">
      <origin xyz="-0.02250 0.00000 0.00000" rpy="-0.00000 1.57080 0.00000" />
      <geometry>
        <cylinder radius="0.00650" length="0.31500" />
      </geometry>
      <material name="design_base_1_color">
        <color rgba="0.55000 0.56000 0.58000 1" />
      </material>
    </visual>
    <visual name="design_base_2">
      <origin xyz="-0.02280 0.06500 -0.00550" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <box size="0.26500 0.10500 0.00150" />
      </geometry>
      <material name="design_base_2_color">
        <color rgba="0.07000 0.07000 0.08000 1" />
      </material>
    </visual>
    <visual name="design_base_3">
      <origin xyz="-0.02280 0.17500 -0.00560" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <box size="0.11500 0.07500 0.00120" />
      </geometry>
      <material name="design_base_3_color">
        <color rgba="0.70000 0.71000 0.74000 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0232126 0.111179 -0.0129876" rpy="3.05278709 -1.57079633 0" />
      <mass value="0.9" />
      <inertia ixx="0.0107799" ixy="0" ixz="0" iyy="0.00733006" iyz="0" izz="0.00347765" />
    </inertial>
    <collision>
      <geometry>
        <mesh filename="meshes/base.obj" />
      </geometry>
    </collision>
  </link>
  <link name="lid">
    <visual name="design_lid_0">
      <origin xyz="-0.02760 -0.03065 0.10875" rpy="0.00000 -1.29608 -1.57080" />
      <geometry>
        <box size="0.22597 0.31050 0.00600" />
      </geometry>
      <material name="design_lid_0_color">
        <color rgba="0.76000 0.78000 0.81000 1" />
      </material>
    </visual>
    <visual name="design_lid_1">
      <origin xyz="-0.02760 -0.02575 0.10800" rpy="0.00000 -1.29569 -1.57080" />
      <geometry>
        <box size="0.19327 0.28500 0.00120" />
      </geometry>
      <material name="design_lid_1_color">
        <color rgba="0.06000 0.09000 0.16000 1" />
      </material>
    </visual>
    <visual name="design_lid_2">
      <origin xyz="-0.02760 -0.03360 0.10800" rpy="1.57080 1.57080 0.00000" />
      <geometry>
        <cylinder radius="0.01200" length="0.00160" />
      </geometry>
      <material name="design_lid_2_color">
        <color rgba="0.08000 0.08000 0.09000 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0276933 -0.030744 0.108682" rpy="1.56398 -0.265453 1.5708" />
      <mass value="0.5" />
      <inertia ixx="0.00612324" ixy="0" ixz="0" iyy="0.00400437" iyz="0" izz="0.0021201" />
    </inertial>
    <collision>
      <geometry>
        <mesh filename="meshes/lid.obj" />
      </geometry>
    </collision>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="base" />
    <child link="lid" />
    <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0" />
    <axis xyz="1.00000 0.00000 0.00000" />
    <limit lower="-1.8613" upper="0.1638" effort="10" velocity="2" />
    <dynamics damping="0.02" friction="0.283534" />
  </joint>
</robot>
