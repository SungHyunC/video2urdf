<?xml version='1.0' encoding='utf-8'?>
<robot name="laptop_lidar">
  <link name="base">
    <inertial>
      <origin xyz="-0.0232126 0.111179 -0.0129876" rpy="0 -1.5708 3.14159" />
      <mass value="0.9" />
      <inertia ixx="0.0107799" ixy="0" ixz="0" iyy="0.00733006" iyz="0" izz="0.00347765" />
    </inertial>
    <visual name="base_0">
      <geometry>
        <mesh filename="meshes/base_tex.obj" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/base.stl" />
      </geometry>
    </collision>
  </link>
  <link name="lid">
    <inertial>
      <origin xyz="-0.0276933 -0.030744 0.108682" rpy="1.56398 -0.265453 1.5708" />
      <mass value="0.5" />
      <inertia ixx="0.00612324" ixy="0" ixz="0" iyy="0.00400437" iyz="0" izz="0.0021201" />
    </inertial>
    <visual name="lid_0">
      <geometry>
        <mesh filename="meshes/lid_tex.obj" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/lid.stl" />
      </geometry>
    </collision>
    <visual name="lid_1">
      <geometry>
        <mesh filename="meshes/screen_tex.obj" />
      </geometry>
    </visual>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="base" />
    <child link="lid" />
    <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0" />
    <axis xyz="1.00000 0.00000 0.00000" />
    <limit lower="-1.8613" upper="0.1638" effort="10" velocity="2" />
    <dynamics damping="0.02" friction="0.283534" />
  </joint>
</robot>