<?xml version="1.0"?>
<robot name="laptop_lidar">
  <link name="base">
    <visual name="base_0"><geometry><mesh filename="meshes/base.stl"/></geometry><material name="base_0_color"><color rgba="0.54902 0.63922 0.69804 1"/></material></visual>
    <collision><geometry><mesh filename="meshes/base.stl"/></geometry></collision>
  </link>
  <link name="lid">
    <visual name="lid_0"><geometry><mesh filename="meshes/lid.stl"/></geometry><material name="lid_0_color"><color rgba="0.30196 0.40784 0.48627 1"/></material></visual>
    <collision><geometry><mesh filename="meshes/lid.stl"/></geometry></collision>
    <visual name="lid_1"><geometry><mesh filename="meshes/screen.stl"/></geometry><material name="lid_1_color"><color rgba="0.22353 0.28235 0.19608 1"/></material></visual>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="base"/>
    <child link="lid"/>
    <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0"/>
    <axis xyz="1.00000 0.00000 0.00000"/>
    <limit lower="-1.8613" upper="0.1638" effort="10" velocity="2"/>
  </joint>
</robot>
