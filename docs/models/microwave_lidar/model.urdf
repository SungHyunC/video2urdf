<?xml version='1.0' encoding='utf-8'?>
<robot name="microwave_lidar">
  <link name="base">
    <inertial>
      <origin xyz="0.430275 0.0961751 -0.0741825" rpy="0 -0 1.71151" />
      <mass value="0.05" />
      <inertia ixx="8.34954e-05" ixy="0" ixz="0" iyy="6.76301e-05" iyz="0" izz="1.5952e-05" />
    </inertial>
    <visual name="base_0">
      <geometry>
        <mesh filename="meshes/base_tex.obj" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/base.stl" />
      </geometry>
    </collision>
  </link>
  <link name="lid">
    <inertial>
      <origin xyz="0.193492 0.0065435 0.002285" rpy="1.63883 -0.0797836 1.5835" />
      <mass value="1.8" />
      <inertia ixx="0.0330592" ixy="0" ixz="0" iyy="0.0224047" iyz="0" izz="0.0107745" />
    </inertial>
    <visual name="lid_0">
      <geometry>
        <mesh filename="meshes/lid_tex.obj" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/lid.stl" />
      </geometry>
    </collision>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="base" />
    <child link="lid" />
    <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0" />
    <axis xyz="0.06898 -0.07864 0.99451" />
    <limit lower="-0.7336" upper="0.2131" effort="10" velocity="2" />
    <dynamics damping="0.02" friction="0.394419" />
  </joint>
</robot>