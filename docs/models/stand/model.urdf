<?xml version='1.0' encoding='utf-8'?>
<!-- Video2URDF model "stand", measured from a video (https://github.com/SungHyunC/video2urdf).
     Mesh and texture paths are relative to this file (meshes/...): this file alone won't load;
     unzip model.zip (the viewer's "Download model + meshes") and load it from there.
     Units: metres, kilograms, radians. Fix the root link "base".
     Collisions are the measured geometry; visuals may be the design, video texture or SAM 3D mesh.
     PyBullet: loadURDF(path, useFixedBase=True, flags=URDF_USE_INERTIA_FROM_FILE).
       PyBullet doesn't apply <dynamics friction>: set VELOCITY_CONTROL, targetVelocity=0,
       force=friction on each joint. MuJoCo 3.2.5+: simulate model.xml, which excludes contacts
       between parts joined by a joint (they overlap there); MuJoCo's URDF import can't.
     The <mujoco> element only keeps mesh paths for MuJoCo's URDF import; other parsers ignore it.
     ROS: mesh paths must become package://<your_package>/meshes/... for RViz and Gazebo. -->
<robot name="stand_2">
  <mujoco>
    <compiler strippath="false" />
  </mujoco>
  <link name="base">
    <visual name="design_base_0">
      <origin xyz="0.00000 0.00000 0.00000" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <mesh filename="meshes/design_base_0.obj" />
      </geometry>
      <material name="design_base_0_color">
        <color rgba="0.92000 0.92000 0.93000 1" />
      </material>
    </visual>
    <visual name="design_base_1">
      <origin xyz="-0.01500 0.00000 0.01560" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <box size="0.07000 0.05500 0.00180" />
      </geometry>
      <material name="design_base_1_color">
        <color rgba="0.86000 0.86000 0.87000 1" />
      </material>
    </visual>
    <visual name="design_base_2">
      <origin xyz="0.03970 0.00000 0.01000" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <box size="0.01400 0.01600 0.01000" />
      </geometry>
      <material name="design_base_2_color">
        <color rgba="0.90000 0.90000 0.91000 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0.000709794 8.31021e-19 6.71188e-05" rpy="-3.7274e-16 -1.55853 -3.14159" />
      <mass value="0.45" />
      <inertia ixx="0.00114864" ixy="0" ixz="0" iyy="0.000637651" iyz="0" izz="0.000569014" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base.obj" />
      </geometry>
    </collision>
  </link>
  <link name="lower_arm">
    <visual name="design_lower_arm_0">
      <origin xyz="0.01025 0.00000 0.12350" rpy="0.00000 -1.51674 0.00000" />
      <geometry>
        <box size="0.23134 0.01400 0.00800" />
      </geometry>
      <material name="design_lower_arm_0_color">
        <color rgba="0.82000 0.83000 0.85000 1" />
      </material>
    </visual>
    <visual name="design_lower_arm_1">
      <origin xyz="0.00200 0.00000 0.00400" rpy="0.00000 -1.10715 0.00000" />
      <geometry>
        <box size="0.00894 0.01000 0.00700" />
      </geometry>
      <material name="design_lower_arm_1_color">
        <color rgba="0.82000 0.83000 0.85000 1" />
      </material>
    </visual>
    <visual name="design_lower_arm_2">
      <origin xyz="0.00000 0.00000 0.00000" rpy="-1.57080 -1.57080 0.00000" />
      <geometry>
        <cylinder radius="0.00420" length="0.01000" />
      </geometry>
      <material name="design_lower_arm_2_color">
        <color rgba="0.90000 0.90000 0.91000 1" />
      </material>
    </visual>
    <visual name="design_lower_arm_3">
      <origin xyz="0.01650 0.00000 0.24250" rpy="-1.57080 -1.57080 0.00000" />
      <geometry>
        <cylinder radius="0.00420" length="0.01000" />
      </geometry>
      <material name="design_lower_arm_3_color">
        <color rgba="0.90000 0.90000 0.91000 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0.0116196 2.01681e-19 0.115613" rpy="0 0.0638385 0" />
      <mass value="0.075" />
      <inertia ixx="0.000309725" ixy="0" ixz="0" iyy="0.000307362" iyz="0" izz="2.63711e-06" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/lower_arm.obj" />
      </geometry>
    </collision>
  </link>
  <link name="upper_arm">
    <visual name="design_upper_arm_0">
      <origin xyz="-0.00800 0.00000 -0.10500" rpy="3.14159 1.49475 3.14159" />
      <geometry>
        <box size="0.21061 0.01400 0.00900" />
      </geometry>
      <material name="design_upper_arm_0_color">
        <color rgba="0.85000 0.86000 0.88000 1" />
      </material>
    </visual>
    <visual name="design_upper_arm_1">
      <origin xyz="-0.01340 0.00000 -0.10600" rpy="3.14159 1.49402 3.14159" />
      <geometry>
        <box size="0.20861 0.01100 0.00180" />
      </geometry>
      <material name="design_upper_arm_1_color">
        <color rgba="0.98000 0.97000 0.92000 1" />
      </material>
    </visual>
    <visual name="design_upper_arm_2">
      <origin xyz="0.00000 0.00000 0.00000" rpy="-1.57080 -1.57080 0.00000" />
      <geometry>
        <cylinder radius="0.00400" length="0.01100" />
      </geometry>
      <material name="design_upper_arm_2_color">
        <color rgba="0.90000 0.90000 0.91000 1" />
      </material>
    </visual>
    <visual name="design_upper_arm_3">
      <origin xyz="-0.01600 0.00000 -0.21000" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <sphere radius="0.00320" />
      </geometry>
      <material name="design_upper_arm_3_color">
        <color rgba="0.88000 0.88000 0.89000 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.010476 6.5465e-19 -0.110646" rpy="0 0.0719112 0" />
      <mass value="0.09" />
      <inertia ixx="0.000324948" ixy="0" ixz="0" iyy="0.00031314" iyz="0" izz="1.21918e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_arm.obj" />
      </geometry>
    </collision>
  </link>
  <joint name="lower_arm_joint" type="revolute">
    <parent link="base" />
    <child link="lower_arm" />
    <origin xyz="0.03973 0 0.01514" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.0114" upper="0.5315" effort="10" velocity="2" />
    <dynamics damping="0.02" friction="0.109883" />
  </joint>
  <joint name="upper_arm_joint" type="revolute">
    <parent link="lower_arm" />
    <child link="upper_arm" />
    <origin xyz="0.01649 0 0.24251" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.4158" upper="0.0137" effort="10" velocity="2" />
    <dynamics damping="0.02" friction="0.122417" />
  </joint>
</robot>
