<?xml version="1.0"?>
<robot name="stand_2">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl"/></geometry>
      <material name="base_color"><color rgba="0.710 0.729 0.761 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl"/></geometry>
    </collision>
  </link>
  <link name="lower_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lower_arm.stl"/></geometry>
      <material name="lower_arm_color"><color rgba="0.424 0.404 0.400 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lower_arm.stl"/></geometry>
    </collision>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/upper_arm.stl"/></geometry>
      <material name="upper_arm_color"><color rgba="0.545 0.565 0.561 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/upper_arm.stl"/></geometry>
    </collision>
  </link>
  <joint name="lower_arm_joint" type="revolute">
    <parent link="base"/>
    <child link="lower_arm"/>
    <origin xyz="0.03973 0 0.01514" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.0114" upper="0.5315" effort="10" velocity="2"/>
  </joint>
  <joint name="upper_arm_joint" type="revolute">
    <parent link="lower_arm"/>
    <child link="upper_arm"/>
    <origin xyz="0.01649 0 0.24251" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.4158" upper="0.0137" effort="10" velocity="2"/>
  </joint>
</robot>
