<?xml version="1.0"?>
<robot name="notebook_2">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl"/></geometry>
      <material name="base_color"><color rgba="0.490 0.486 0.486 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl"/></geometry>
    </collision>
  </link>
  <link name="lid">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lid.stl"/></geometry>
      <material name="lid_color"><color rgba="0.310 0.247 0.227 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lid.stl"/></geometry>
    </collision>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="base"/>
    <child link="lid"/>
    <origin xyz="0.07332 0 0.00169" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.0683" upper="1.2798" effort="10" velocity="2"/>
  </joint>
</robot>
