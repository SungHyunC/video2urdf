<?xml version="1.0"?>
<robot name="office_pedestal">
  <!-- world to fix base -->
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Cabinet carcass, origin at floor center under cabinet -->
  <link name="base_link">
    <inertial>
      <mass value="18.0"/>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <inertia ixx="1.5" ixy="0" ixz="0" iyy="1.5" iyz="0" izz="1.0"/>
    </inertial>
    <!-- bottom panel -->
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.42 0.018"/>
      </geometry>
      <material name="beech">
        <color rgba="0.87 0.71 0.49 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.42 0.018"/>
      </geometry>
    </collision>
    <!-- top panel -->
    <visual>
      <origin xyz="0 0 0.591" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.42 0.018"/>
      </geometry>
      <material name="beech"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.591" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.42 0.018"/>
      </geometry>
    </collision>
    <!-- left side -->
    <visual>
      <origin xyz="0 0.201 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.018 0.564"/>
      </geometry>
      <material name="beech"/>
    </visual>
    <collision>
      <origin xyz="0 0.201 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.018 0.564"/>
      </geometry>
    </collision>
    <!-- right side -->
    <visual>
      <origin xyz="0 -0.201 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.018 0.564"/>
      </geometry>
      <material name="beech"/>
    </visual>
    <collision>
      <origin xyz="0 -0.201 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.018 0.564"/>
      </geometry>
    </collision>
    <!-- back panel -->
    <visual>
      <origin xyz="-0.271 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.384 0.564"/>
      </geometry>
      <material name="beech"/>
    </visual>
    <collision>
      <origin xyz="-0.271 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.384 0.564"/>
      </geometry>
    </collision>
  </link>

  <!-- BOTTOM DRAWER (opened first in video) -->
  <joint name="drawer_bottom_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_bottom_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.36" effort="100" velocity="1.0"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>
  <link name="drawer_bottom_link">
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
    <!-- front -->
    <visual>
      <origin xyz="0.28 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.40 0.165"/>
      </geometry>
      <material name="beech">
        <color rgba="0.80 0.62 0.42 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.28 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.40 0.165"/>
      </geometry>
    </collision>
    <!-- tub -->
    <visual>
      <origin xyz="0.041 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.34 0.10"/>
      </geometry>
      <material name="dark">
        <color rgba="0.15 0.15 0.17 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.041 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.34 0.10"/>
      </geometry>
    </collision>
    <!-- handle horizontal -->
    <visual>
      <origin xyz="0.305 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.13 0.02"/>
      </geometry>
      <material name="metal">
        <color rgba="0.75 0.76 0.78 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.305 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.13 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- MIDDLE DRAWER (opened second in video) -->
  <joint name="drawer_middle_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_middle_link"/>
    <origin xyz="0 0 0.305" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.36" effort="100" velocity="1.0"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>
  <link name="drawer_middle_link">
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0.28 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.40 0.165"/>
      </geometry>
      <material name="beech"/>
    </visual>
    <collision>
      <origin xyz="0.28 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.40 0.165"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.041 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.34 0.10"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.041 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.34 0.10"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.305 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.13 0.02"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.305 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.13 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- TOP DRAWER with lock -->
  <joint name="drawer_top_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_top_link"/>
    <origin xyz="0 0 0.485" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.36" effort="100" velocity="1.0"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>
  <link name="drawer_top_link">
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0.28 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.40 0.165"/>
      </geometry>
      <material name="beech"/>
    </visual>
    <collision>
      <origin xyz="0.28 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.40 0.165"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.041 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.34 0.10"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.041 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.34 0.10"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.305 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.13 0.02"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.305 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.13 0.02"/>
      </geometry>
    </collision>
    <!-- lock cylinder on top drawer front -->
    <visual>
      <origin xyz="0.29 0.15 0.055" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.011" length="0.012"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.29 0.15 0.055" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.011" length="0.012"/>
      </geometry>
    </collision>
  </link>
</robot>
