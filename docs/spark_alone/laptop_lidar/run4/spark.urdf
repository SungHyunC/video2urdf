<robot name="macbook_laptop">
  <link name="world"/>
  <joint name="floating_base" type="floating">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2124 0.3041 0.01"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.76 0.78 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2124 0.3041 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.006948" ixy="0.0" ixz="0.0" iyy="0.003388" iyz="0.0" izz="0.010302"/>
    </inertial>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="screen_link"/>
    <origin xyz="-0.1062 0 0.005" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="1.95" effort="2.0" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="screen_link">
    <visual>
      <origin xyz="0.1062 0 0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.2124 0.3041 0.006"/>
      </geometry>
      <material name="silver_dark">
        <color rgba="0.72 0.73 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.1062 0 0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.2124 0.3041 0.006"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.1062 0 0.003" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.003853" ixy="0.0" ixz="0.0" iyy="0.001875" iyz="0.0" izz="0.005723"/>
    </inertial>
  </link>
</robot>
