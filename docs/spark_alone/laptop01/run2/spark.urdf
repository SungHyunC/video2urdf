<?xml version="1.0"?>
<robot name="laptop">
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01527" ixy="0" ixz="0" iyy="0.01068" iyz="0" izz="0.02542"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.30 0.04"/>
      </geometry>
      <material name="beige">
        <color rgba="0.82 0.80 0.74 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.30 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="screen_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <inertia ixx="0.00692" ixy="0" ixz="0" iyy="0.00244" iyz="0" izz="0.00452"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.30 0.22"/>
      </geometry>
      <material name="beige2">
        <color rgba="0.82 0.80 0.74 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.30 0.22"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="screen_link"/>
    <origin xyz="-0.125 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.2" upper="1.60" effort="5.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
</robot>
