<?xml version="1.0"?>
<robot name="laptop">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.29 0.04"/>
      </geometry>
      <material name="beige">
        <color rgba="0.82 0.80 0.74 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.29 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01428" ixy="0" ixz="0" iyy="0.00987" iyz="0" izz="0.02361"/>
    </inertial>
  </link>

  <link name="screen_link">
    <visual>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.29 0.23"/>
      </geometry>
      <material name="beige">
        <color rgba="0.82 0.80 0.74 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.29 0.23"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
      <inertia ixx="0.00913" ixy="0" ixz="0" iyy="0.00355" iyz="0" izz="0.00563"/>
    </inertial>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="screen_link"/>
    <origin xyz="-0.12 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.5708" effort="10" velocity="5"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
</robot>
